# Optional: enables full LLM chat. Without it, embeddings use a local model
# and chat returns a "configure API key" message.
OPENAI_API_KEY=

# Optional: for Azure OpenAI or other OpenAI-compatible endpoints
OPENAI_BASE_URL=

# Embedding model for local (no API key) mode
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM model when API key is set
LLM_MODEL=gpt-4o-mini

# Delta Lake storage path (inside container)
DELTA_LAKE_PATH=/data/delta

# ChromaDB connection
CHROMA_HOST=chromadb
CHROMA_PORT=8100

# Upload directory
UPLOAD_DIR=/data/uploads
